OPENROUTER_API_KEY=
# 優先使用 6 個免費模型做輪詢；若留空，scene_service.py 也會使用同一組預設值
OPENROUTER_MODELS=tencent/hy3:free,google/gemma-3-27b-it:free,qwen/qwen3-32b:free,meta-llama/llama-3.3-70b-instruct:free,mistralai/devstral-small:free,cohere/north-mini-code:free
# 若只想固定單一模型，可改用 OPENROUTER_MODEL，未設定 OPENROUTER_MODELS 時才會生效
OPENROUTER_MODEL=
# 平面圖視覺建議模型池；只有前端勾選同意且有 API key 時才會送出 PNG
OPENROUTER_VISION_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_FLOORPLAN_VLM=1
# 需求問卷只有在使用者勾選同意且進階自由文字非空時才會呼叫
OPENROUTER_REQUIREMENTS_ENABLED=1
# 2D 家具選件／擺放語意提示；仍須前端另行取得使用者同意才會送出
OPENROUTER_LAYOUT_ENABLED=1
OPENROUTER_SITE_URL=http://127.0.0.1:8002
OPENROUTER_APP_NAME="RoomPilot floorplan VLM"
