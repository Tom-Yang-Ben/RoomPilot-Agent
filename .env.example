# OpenRouter LLM settings.
# Copy this file to .env and fill real secrets locally.
# Leave OPENROUTER_API_KEY empty to use local fallback rules.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=tencent/hy3:free,google/gemma-3-27b-it:free,qwen/qwen3-32b:free,meta-llama/llama-3.3-70b-instruct:free,mistralai/devstral-small:free,cohere/north-mini-code:free
# If you want one fixed model, clear OPENROUTER_MODELS and set OPENROUTER_MODEL.
OPENROUTER_MODEL=
# 平面圖視覺建議模型池；只有前端勾選同意且有 API key 時才會送出 PNG
OPENROUTER_VISION_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_FLOORPLAN_VLM=1
# 需求問卷只有在使用者勾選同意且進階自由文字非空時才會呼叫
OPENROUTER_REQUIREMENTS_ENABLED=1
# 2D 家具選件／擺放語意提示；仍須前端另行取得使用者同意才會送出
OPENROUTER_LAYOUT_ENABLED=1
OPENROUTER_SITE_URL=http://127.0.0.1:8002
OPENROUTER_APP_NAME="RoomPilot floorplan VLM"

# ── 以下由 bella-test1 併入:RAG / PostgreSQL / 雲端型錄 / 遠端算圖 ──
OPENROUTER_SITE_URL=http://127.0.0.1:8002
OPENROUTER_APP_NAME=roompilot

# Django furniture RAG test page. Disabled by default to protect paid API usage.
ROOMPILOT_RAG_ENABLED=false
# Choose exactly one parser provider: openai or anthropic.
ROOMPILOT_RAG_PARSER_PROVIDER=openai
# Fill only the key for the selected provider. Never commit a real key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Provider defaults; ROOMPILOT_RAG_PARSER_MODEL can override the selected one.
ROOMPILOT_RAG_OPENAI_MODEL=gpt-5.6-sol
ROOMPILOT_RAG_ANTHROPIC_MODEL=claude-sonnet-4-6
ROOMPILOT_RAG_PARSER_MODEL=
ROOMPILOT_RAG_REASONING_EFFORT=low
ROOMPILOT_RAG_ANTHROPIC_MAX_TOKENS=4096
ROOMPILOT_RAG_TIMEOUT_SECONDS=30
# Optional external Hugging Face cache path; leave blank for the user cache.
ROOMPILOT_RAG_MODEL_CACHE=
# auto, cpu, cuda, or mps
ROOMPILOT_RAG_DEVICE=auto

# Furniture model delivery. Use cloudfront for the official 9,350 cloud catalog.
ROOMPILOT_MODEL_DELIVERY_MODE=cloudfront
# Furniture metadata source. postgres is strict, is also the unset default, and returns 503 when SQL is unavailable.
# Set to json only when deliberately running an offline development fallback.
ROOMPILOT_CATALOG_PROVIDER=postgres
# Phase 4/5 style/surface/cost/quarantine runtime source. postgres is strict and the unset default.
# JSON/CSV remain versioned import seeds; use json only for explicit offline development.
ROOMPILOT_RUNTIME_CATALOG_PROVIDER=postgres
# Phase 2 furniture write API. Generate a long random value and never commit .env.
ROOMPILOT_CATALOG_ADMIN_TOKEN=
# Optional local/offline GLB zip directories. Separate multiple paths with the OS path separator.
ROOMPILOT_EXTERNAL_GLB_ZIP_DIRS=

# Phase 3 project/workflow persistence. sqlite is for explicit offline development only.
ROOMPILOT_PROJECT_STORE_PROVIDER=postgres

# Designer-locked engineering documents. Production is the safe default:
# missing price/productivity records remain pending instead of being guessed.
ROOMPILOT_DEMO_MODE=false
# Node executable used only by the @oai/artifact-tool XLSX adapter.
ROOMPILOT_ARTIFACT_NODE=node
# Optional absolute node_modules directory containing @oai/artifact-tool.
# Leave blank when Node can already resolve the package.
ROOMPILOT_ARTIFACT_TOOL_MODULES=
ROOMPILOT_XLSX_TIMEOUT_SECONDS=90

# Remote render provider. Leave URL/TOKEN empty to return 503 instead of faking render success.
ROOMPILOT_RENDER_PROVIDER_URL=
ROOMPILOT_RENDER_PROVIDER_NAME=remote_renderer
ROOMPILOT_RENDER_PROVIDER_TOKEN=
ROOMPILOT_RENDER_PROVIDER_TIMEOUT_SECONDS=60

# PostgreSQL catalog import. Copy this file to .env and fill DB_PASSWORD locally.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roompilot_db
DB_ADMIN_DB=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_APPLICATION_NAME=roompilot_catalog_import
DB_PROJECT_APPLICATION_NAME=roompilot_project_store
