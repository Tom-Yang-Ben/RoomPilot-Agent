# OpenRouter LLM settings.
# Copy this file to .env and fill real secrets locally.
# Leave OPENROUTER_API_KEY empty to use local fallback rules.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=tencent/hy3:free,google/gemma-3-27b-it:free,qwen/qwen3-32b:free,meta-llama/llama-3.3-70b-instruct:free,mistralai/devstral-small:free,cohere/north-mini-code:free
# If you want one fixed model, clear OPENROUTER_MODELS and set OPENROUTER_MODEL.
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://127.0.0.1:8002
OPENROUTER_APP_NAME=roompilot

# Furniture model delivery. Use cloudfront for the official 9,350 cloud catalog.
ROOMPILOT_MODEL_DELIVERY_MODE=cloudfront
# Furniture metadata source. PostgreSQL is preferred; JSON is an offline fallback.
# Set to json only when deliberately testing without the local PostgreSQL catalog.
ROOMPILOT_CATALOG_PROVIDER=postgres
# Optional local/offline GLB zip directories. Separate multiple paths with the OS path separator.
ROOMPILOT_EXTERNAL_GLB_ZIP_DIRS=

# Remote render provider. Leave URL/TOKEN empty to return 503 instead of faking render success.
ROOMPILOT_RENDER_PROVIDER_URL=
ROOMPILOT_RENDER_PROVIDER_NAME=remote_renderer
ROOMPILOT_RENDER_PROVIDER_TOKEN=
ROOMPILOT_RENDER_PROVIDER_TIMEOUT_SECONDS=60

# PostgreSQL catalog import. Copy this file to .env and fill DB_PASSWORD locally.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roompilot_db
DB_ADMIN_DB=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=roompilot_catalog_import

# Django furniture RAG (vector search). Disabled by default.
# Parser providers: openrouter | openai | anthropic
# openrouter reuses OPENROUTER_API_KEY / OPENROUTER_MODELS above.
ROOMPILOT_RAG_ENABLED=false
ROOMPILOT_RAG_PARSER_PROVIDER=openrouter
ROOMPILOT_RAG_OPENROUTER_MODELS=openai/gpt-4o-mini,cohere/north-mini-code:free
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
ROOMPILOT_RAG_OPENAI_MODEL=gpt-5.6-sol
ROOMPILOT_RAG_ANTHROPIC_MODEL=claude-sonnet-4-6
ROOMPILOT_RAG_PARSER_MODEL=
ROOMPILOT_RAG_REASONING_EFFORT=low
ROOMPILOT_RAG_ANTHROPIC_MAX_TOKENS=4096
ROOMPILOT_RAG_TIMEOUT_SECONDS=30
ROOMPILOT_RAG_MODEL_CACHE=
ROOMPILOT_RAG_DEVICE=auto
