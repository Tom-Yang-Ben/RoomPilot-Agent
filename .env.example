# OpenRouter LLM settings.
# Copy this file to .env and fill real secrets locally.
# Leave OPENROUTER_API_KEY empty to use local fallback rules.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=tencent/hy3:free,google/gemma-3-27b-it:free,qwen/qwen3-32b:free,meta-llama/llama-3.3-70b-instruct:free,mistralai/devstral-small:free,cohere/north-mini-code:free
# If you want one fixed model, clear OPENROUTER_MODELS and set OPENROUTER_MODEL.
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://127.0.0.1:8002
OPENROUTER_APP_NAME=roompilot

# Django furniture RAG test page. Disabled by default to protect paid API usage.
ROOMPILOT_RAG_ENABLED=false
# Choose exactly one parser provider: openai or anthropic.
ROOMPILOT_RAG_PARSER_PROVIDER=openai
# Fill only the key for the selected provider. Never commit a real key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Provider defaults; ROOMPILOT_RAG_PARSER_MODEL can override the selected one.
ROOMPILOT_RAG_OPENAI_MODEL=gpt-5.6-sol
ROOMPILOT_RAG_ANTHROPIC_MODEL=claude-sonnet-4-6
ROOMPILOT_RAG_PARSER_MODEL=
ROOMPILOT_RAG_REASONING_EFFORT=low
ROOMPILOT_RAG_ANTHROPIC_MAX_TOKENS=4096
ROOMPILOT_RAG_TIMEOUT_SECONDS=30
# Optional external Hugging Face cache path; leave blank for the user cache.
ROOMPILOT_RAG_MODEL_CACHE=
# auto, cpu, cuda, or mps
ROOMPILOT_RAG_DEVICE=auto

# Furniture model delivery. Use cloudfront for the official 8,675-item cloud catalog.
ROOMPILOT_MODEL_DELIVERY_MODE=cloudfront
# Furniture metadata source. postgres is strict, is also the unset default, and returns 503 when SQL is unavailable.
# Set to json only when deliberately running an offline development fallback.
ROOMPILOT_CATALOG_PROVIDER=postgres
# The current checkout still loads style/surface/cost runtime data from versioned JSON.
# Keep json until the Phase 4/5 PostgreSQL tables, importer, and runtime repository exist.
ROOMPILOT_RUNTIME_CATALOG_PROVIDER=json
# Phase 2 furniture write API. Generate a long random value and never commit .env.
ROOMPILOT_CATALOG_ADMIN_TOKEN=
# Optional local/offline GLB zip directories. Separate multiple paths with the OS path separator.
ROOMPILOT_EXTERNAL_GLB_ZIP_DIRS=

# The current FastAPI ProjectStore is SQLite-backed. This variable is reserved for
# Bella's future PostgreSQL ProjectStore factory; changing it alone does not migrate data.
ROOMPILOT_PROJECT_STORE_PROVIDER=sqlite

# Designer-locked engineering documents. Production is the safe default:
# missing price/productivity records remain pending instead of being guessed.
ROOMPILOT_DEMO_MODE=false
# Node executable used only by the @oai/artifact-tool XLSX adapter.
ROOMPILOT_ARTIFACT_NODE=node
# Optional absolute node_modules directory containing @oai/artifact-tool.
# Leave blank when Node can already resolve the package.
ROOMPILOT_ARTIFACT_TOOL_MODULES=
ROOMPILOT_XLSX_TIMEOUT_SECONDS=90

# Remote render provider. Leave URL/TOKEN empty to return 503 instead of faking render success.
ROOMPILOT_RENDER_PROVIDER_URL=
ROOMPILOT_RENDER_PROVIDER_NAME=remote_renderer
ROOMPILOT_RENDER_PROVIDER_TOKEN=
ROOMPILOT_RENDER_PROVIDER_TIMEOUT_SECONDS=60

# Team handoff boundary (never put real secrets in this example):
# - Frontend gives the backend/API owner requested field and CloudFront URL-format feedback.
#   Frontend receives only the backend API URL, API docs, and furniture field contract; no DB/AWS credentials.
# - Backend gives the SQL/catalog owner its deployment environment, secret-injection destination,
#   CA bundle mount path, and required application connection scope.
# - RAG gives the SQL/catalog owner furniture_embeddings_bge_m3.jsonl plus model, dimension,
#   normalized, text_hash, generated_at, and validation-report metadata; no Master credentials are needed.
# - AWS users give only their individual IAM Identity Center/IAM identity and required job scope.
#   Never exchange Root credentials, roompilot-cloud-admin credentials, or AWS access keys.

# ===== 資料庫連線選擇說明 =====
# 複製本檔為 .env 後，請在「方案 A」與「方案 B」中擇一使用。
# 不要同時保留兩組未註解的 DB_* 設定，避免後面的重複鍵覆蓋前面的值。
#
# ===== 方案 A：組員本機 PostgreSQL（預設啟用） =====
# 1. 請複製本檔為 .env；不要提交自己的 .env，也不要把任何密碼寫回 .env.example。
# 2. 下方預設連線組員自己的本機 PostgreSQL，不會連到 Kai 的 AWS RDS。
# 3. 本機 PostgreSQL 必須先建立 roompilot_db、安裝必要 Extension，並匯入正式家具資料。
# 4. 若本機 PostgreSQL 帳號不是 postgres，請只在自己的 .env 修改 DB_USER 與 DB_PASSWORD。
# 5. 本機 sslmode=disable，因此 PGSSLROOTCERT 保持空白；這只適用於本機開發。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roompilot_db
DB_ADMIN_DB=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable
PGSSLROOTCERT=
DB_CONNECT_TIMEOUT=10
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_APPLICATION_NAME=roompilot_local
DB_PROJECT_APPLICATION_NAME=roompilot_project_store

# ===== 方案 B：AWS RDS 雲端 PostgreSQL（選用，預設全部註解） =====
# 只有經 Kai 授權、確實需要直連雲端 SQL 的後端／RAG 組員才能選擇本方案。
# 使用方式：先複製本檔為自己的 .env，再用下方數值取代「方案 A」的 DB_* 設定；
# 不要直接取消註解並留下方案 A 的重複鍵，也不要修改或提交 .env.example。
#
# 啟用前必須完成：
# 1. 向 Kai 取得真正的 RDS Endpoint，取代 DB_HOST 裡的 REPLACE_ME。
# 2. 由 Kai 透過安全管道個別提供 roompilot_api 密碼；DB_PASSWORD 不得進入 Git。
# 3. 取得 certs/global-bundle.pem，並把 PGSSLROOTCERT 改成自己電腦上的完整路徑。
# 4. 將目前公開 IP 提供給 Kai，由 Kai 以 IP/32 加入 RDS Security Group。
# 5. 全程使用 DB_SSLMODE=verify-full；不得為了方便改成 disable。
#
# 前端組員不需要本方案，也不需要 Endpoint、資料庫密碼、CA 憑證或 AWS Access Key。
# roompilot_master 只供受控匯入與 schema 管理；應用程式一律使用限權 roompilot_api。
#
# DB_HOST=roompilot-postgres-prod.REPLACE_ME.ap-east-2.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=roompilot_db
# DB_ADMIN_DB=postgres
# DB_USER=roompilot_api
# DB_PASSWORD=
# DB_SSLMODE=verify-full
# PGSSLROOTCERT=C:/Users/REPLACE_ME/RoomPilot-Agent/certs/global-bundle.pem
# DB_CONNECT_TIMEOUT=15
# DB_POOL_MIN=1
# DB_POOL_MAX=8
# DB_APPLICATION_NAME=roompilot_api
# DB_PROJECT_APPLICATION_NAME=roompilot_project_store
