# 複製本檔為 .env 並填入實際值(.env 已在 .gitignore,不會被上傳)
# PostgreSQL 連線設定 — scripts/import_catalog_to_postgres.py 讀取以下變數
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roompilot_db
DB_USER=postgres
DB_PASSWORD=

# OpenRouter LLM 設定 — web_fastapi/scene_pipeline.py 讀取(留空則走本地 fallback 規則)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://127.0.0.1:8002
OPENROUTER_APP_NAME=roompilot
