# RoomPilot public development defaults. Copy to .env; never commit .env.
ROOMPILOT_PROFILE=portable

# Leave blank to derive from the profile (fixture for portable, postgres for full).
ROOMPILOT_CATALOG_PROVIDER=
ROOMPILOT_MODEL_DELIVERY_MODE=local

# This preview is local-development software, not a public-internet service.
ROOMPILOT_HOST=127.0.0.1
ROOMPILOT_PORT=8002

# Optional AI features. Empty credentials must return "not configured".
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://127.0.0.1:8002
OPENROUTER_APP_NAME=roompilot
ROOMPILOT_AGENT_LLM_TIMEOUT=120
OPENROUTER_INTAKE_ENABLED=0
OPENROUTER_SCENE_PLANNING_ENABLED=0
ROOMPILOT_RAG_ENABLED=false
ROOMPILOT_RAG_PARSER_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ROOMPILOT_RAG_MODEL_CACHE=
ROOMPILOT_RAG_DEVICE=auto

# Optional floor-plan models and reference assets. Keep these outside Git.
ROOM_HEAD=
ROOMPILOT_SYMBOL_LIBRARY=
ROOMPILOT_OPENING_MODEL=
ROOMPILOT_ICON_TEMPLATE_DIR=
ROOMPILOT_REFERENCE_FLOORPLAN=
ROOMPILOT_REFERENCE_ANNOTATIONS=

# Optional local GLB sources. No Downloads or repository directory is scanned.
ROOMPILOT_LOCAL_GLB_ROOTS=
ROOMPILOT_EXTERNAL_GLB_ZIP_DIRS=

# Optional remote rendering. Empty URL/token returns 503.
ROOMPILOT_RENDER_PROVIDER_URL=
ROOMPILOT_RENDER_PROVIDER_NAME=remote_renderer
ROOMPILOT_RENDER_PROVIDER_TOKEN=
ROOMPILOT_RENDER_PROVIDER_TIMEOUT_SECONDS=60

# Full-profile PostgreSQL. Supply your own licensed catalog.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=roompilot_db
DB_USER=roompilot
DB_PASSWORD=
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_APPLICATION_NAME=roompilot_catalog

# Optional delivery tools.
ROOMPILOT_DEMO_MODE=false
ROOMPILOT_ARTIFACT_NODE=node
ROOMPILOT_ARTIFACT_TOOL_MODULES=
ROOMPILOT_XLSX_TIMEOUT_SECONDS=90
