OPENROUTER_API_KEY=
# 優先使用 6 個免費模型做輪詢；若留空，scene_service.py 也會使用同一組預設值
OPENROUTER_MODELS=tencent/hy3:free,google/gemma-3-27b-it:free,qwen/qwen3-32b:free,meta-llama/llama-3.3-70b-instruct:free,mistralai/devstral-small:free,cohere/north-mini-code:free
# 若只想固定單一模型，可改用 OPENROUTER_MODEL，未設定 OPENROUTER_MODELS 時才會生效
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_NAME=test_furniture

# 家具模型正式來源。預設 cloudfront；只有確認雲端故障且本機備援包通過驗證後才改成 local。
ROOMPILOT_MODEL_DELIVERY_MODE=cloudfront
# local 模式可填 zip 檔或資料夾。Windows 多路徑以分號分隔，macOS/Linux 以冒號分隔。
ROOMPILOT_EXTERNAL_GLB_ZIP_DIRS=

# 第 10 步遠端生圖服務。未設定時 UI 只顯示尚未連接，不會產生假結果。
ROOMPILOT_RENDER_PROVIDER_URL=
ROOMPILOT_RENDER_PROVIDER_NAME=remote_renderer
ROOMPILOT_RENDER_PROVIDER_TOKEN=
ROOMPILOT_RENDER_PROVIDER_TIMEOUT_SECONDS=60

# PostgreSQL catalog import. Copy this file to .env and fill DB_PASSWORD locally.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roompilot_db
DB_ADMIN_DB=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=roompilot_catalog_import
