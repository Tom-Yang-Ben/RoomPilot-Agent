{
  "taxonomy_version": "v1-draft",
  "styles": {
    "nordic": {
      "zh": "北歐風",
      "definition": "淺色原木與白色基調,搭配大地色與柔和灰,線條簡潔圓潤,布藝、羊毛與淺色木材為主,重視自然採光、留白與溫暖質感,氛圍明亮放鬆。"
    },
    "japandi": {
      "zh": "日式無印",
      "definition": "日式侘寂與北歐簡約的融合,原木、藤編、亞麻等自然材質,低彩度大地色,家具低矮貼地,線條乾淨,強調收納整齊與寧靜秩序感。"
    },
    "modern": {
      "zh": "現代簡約",
      "definition": "俐落直線與幾何形體,黑白灰為主色,玻璃、金屬與烤漆面材,裝飾極少,強調機能與比例,整體乾淨明快、都會感強。"
    },
    "industrial": {
      "zh": "工業風",
      "definition": "裸露質感為特色,黑鐵件、深色木材、皮革與水泥灰,粗獷金屬結構外露,色調深沉,氛圍粗獷率性,常見鉚釘、管線等元素。"
    },
    "scandi_luxe": {
      "zh": "輕奢風",
      "definition": "以現代簡約為底加入精緻元素,大理石紋、黃銅金屬、絲絨面料,色調高級沉穩(墨綠、駝色、燕麥色),點綴金屬光澤,質感細膩。"
    },
    "french_country": {
      "zh": "法式鄉村",
      "definition": "優雅曲線與雕花細節,洗白或奶油色木質,碎花與條紋布藝,鑄鐵與陶瓷配件,色調柔美溫潤,氛圍浪漫懷舊。"
    },
    "american_classic": {
      "zh": "美式經典",
      "definition": "厚實木作與線板細節,深色胡桃木或櫻桃木,皮革與格紋布藝,色調沉穩大器,強調舒適包覆感與家庭氛圍。"
    },
    "minimalist": {
      "zh": "極簡風",
      "definition": "去除一切裝飾,形隨機能,單色或雙色配置,平整無把手面板,視覺重量極輕,強調空、靜、純粹的空間感。"
    },
    "boho": {
      "zh": "波希米亞",
      "definition": "手工編織、流蘇、藤與麻繩元素,多層次圖騰與民族紋樣,暖色大地色系混搭綠植,自由隨性、層疊豐富的裝飾感。"
    },
    "mid_century": {
      "zh": "中古世紀現代",
      "definition": "1950-60 年代經典設計語彙,胡桃木斜腳、圓潤有機曲線,芥末黃、墨綠、橘棕等復古色,兼具雕塑感與功能性。"
    },
    "rustic": {
      "zh": "鄉村自然",
      "definition": "原始粗獷的自然材質,節疤原木、粗織布料、石材,色調樸拙溫暖,保留材料原貌,氛圍質樸踏實、貼近自然。"
    },
    "contemporary": {
      "zh": "當代混搭",
      "definition": "不拘單一流派,以中性底色混搭多種材質與時代元素,比例協調為先,彈性高、包容性強,適合作為過渡與通用風格。"
    }
  },
