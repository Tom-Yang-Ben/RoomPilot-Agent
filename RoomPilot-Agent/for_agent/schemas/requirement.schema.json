{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "requirement.json",
  "description": "Agent 1 產出:正規化後的設計需求",
  "type": "object",
  "required": [
    "style",
    "room_type",
    "requirement",
    "constraints"
  ],
  "properties": {
    "style": {
      "type": "string",
      "description": "設計風格，如 日式風格 / 北歐風 / 工業風"
    },
    "room_type": {
      "type": "string",
      "description": "房型，如 客廳 / 臥室 / 書房"
    },
    "prefer_color": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "主色調或色系傾向；使用者未提則為 null"
    },
    "requirement": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "接近原話的條列需求，供人審閱與追溯"
    },
    "constraints": {
      "type": "object",
      "required": [
        "exclude_categories",
        "include_categories"
      ],
      "properties": {
        "exclude_categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "不可出現的家具大類"
        },
        "include_categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "必須出現的家具大類"
        },
        "must_keep": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "需保留的現有家具"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "取代關係、語意衝突等補充"
        }
      }
    }
  }
}