{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rule.json",
  "description": "人工預先定義的硬性規則集，validate_layout.py 逐條檢查",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": {"type": "string", "description": "規則識別碼，違規報告會引用"},
          "type": {
            "type": "string",
            "enum": [
              "no_overlap",
              "within_room",
              "min_walkway",
              "clearance_zone",
              "door_swing",
              "window_access",
              "max_footprint_ratio"
            ],
            "description": "規則型別，決定 validate_layout.py 用哪個檢查器"
          },
          "description": {"type": "string", "description": "人可讀的規則說明"},
          "enabled": {"type": "boolean", "default": true},
          "severity": {"type": "string", "enum": ["error", "warning"], "default": "error"},
          "params": {
            "type": "object",
            "description": "規則參數，依 type 而定",
            "properties": {
              "min_distance_cm": {"type": "number", "description": "min_walkway / clearance 的最小間隙"},
              "tolerance_cm": {"type": "number", "description": "no_overlap 容許的微量重疊"},
              "max_ratio": {"type": "number", "description": "max_footprint_ratio：單件占房間面積上限"},
              "clearance_cm": {"type": "number", "description": "window_access 窗前淨空深度"}
            }
          },
          "applies_to": {
            "type": "array",
            "items": {"type": "string"},
            "description": "適用的家具類別；[\"*\"] 表全部"
          }
        }
      }
    }
  }
}
