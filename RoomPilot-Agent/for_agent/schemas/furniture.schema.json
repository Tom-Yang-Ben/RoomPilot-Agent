{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "furniture.json",
  "description": "Agent 3 產出:最終布置，每件家具的位置與朝向",
  "type": "object",
  "required": ["furniture"],
  "properties": {
    "room_type": {"type": "string"},
    "furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "catalog_id", "category", "position", "rotation", "dimensions", "glb_path"],
        "properties": {
          "id": {"type": "string", "description": "布置實例編號，如 f_1；同款可多件"},
          "catalog_id": {"type": "string", "description": "對應候選的資料庫主鍵"},
          "name": {"type": "string"},
          "category": {"type": "string"},
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "number"}, "y": {"type": "number"},
              "z": {"type": "number", "description": "離地高，通常 0；壁掛物才需要"}
            },
            "description": "家具中心點(cm)"
          },
          "rotation": {"type": "number", "description": "逆時針度，0 時正面朝 +Y"},
          "dimensions": {
            "type": "object",
            "required": ["width", "depth", "height"],
            "properties": {
              "width": {"type": "number"}, "depth": {"type": "number"}, "height": {"type": "number"}
            }
          },
          "glb_path": {"type": "string"},
          "clearance_zones": {
            "type": "array",
            "description": "使用此家具所需的淨空區，供驗證器檢查",
            "items": {
              "type": "object",
              "required": ["anchor", "depth"],
              "properties": {
                "anchor": {"type": "string", "enum": ["front", "back", "left", "right"]},
                "depth": {"type": "number", "description": "該方向需淨空的深度(cm)"},
                "width": {"type": "number", "description": "淨空區寬度(cm)，預設同該邊家具寬"}
              }
            }
          },
          "note": {"type": "string"}
        }
      }
    }
  }
}
