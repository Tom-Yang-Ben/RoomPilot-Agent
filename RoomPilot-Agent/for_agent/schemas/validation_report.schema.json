{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "validation_report.json",
  "description": "validate_layout.py 產出:驗證結果與違規清單",
  "type": "object",
  "required": ["passed", "violations"],
  "properties": {
    "passed": {"type": "boolean"},
    "iteration": {"type": "integer", "description": "第幾輪驗證，供迴圈控制"},
    "summary": {
      "type": "object",
      "properties": {
        "total": {"type": "integer"},
        "errors": {"type": "integer"},
        "warnings": {"type": "integer"}
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "rule_id", "type", "message"],
        "properties": {
          "object_id": {"type": "string", "description": "違規家具 id；跨物件違規取主要物件"},
          "rule_id": {"type": "string", "description": "違反的 rule.json 規則 id 或需求鍵"},
          "type": {
            "type": "string",
            "enum": ["rule", "requirement"],
            "description": "rule=硬性規則；requirement=需求層(include/exclude)"
          },
          "severity": {"type": "string", "enum": ["error", "warning"]},
          "message": {"type": "string", "description": "人可讀說明"},
          "metrics": {
            "type": "object",
            "description": "量化數據，供 Agent 4 產生精確修改量",
            "properties": {
              "measured_cm": {"type": "number"},
              "required_cm": {"type": "number"},
              "overlap_area_cm2": {"type": "number"},
              "other_id": {"type": "string", "description": "牽涉的另一物件"}
            }
          },
          "suggested_fix": {
            "type": "object",
            "description": "腳本給的初步修法，Agent 4 可再精修",
            "properties": {
              "action": {"type": "string", "enum": ["move", "rotate", "replace", "remove"]},
              "axis": {"type": "string", "description": "如 +x / -x / +y / -y"},
              "min_delta_cm": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
