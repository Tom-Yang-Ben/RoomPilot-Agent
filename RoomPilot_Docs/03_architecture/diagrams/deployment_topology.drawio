<mxCell id="t" value="RoomPilot 部署拓撲（AS-IS · Pilot 單機 loopback）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="st" value="八步工作流的邏輯容器跑在哪台機器／哪個行程／哪個埠；執行資料落在哪個檔案或資料庫；跨邊界連線的協定與失敗語意。全圖無 🔜 節點——未落地的元件不畫，見 md §4。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1300" height="22" as="geometry"/></mxCell><mxCell id="host" value="開發者工作站（單機；app 未容器化、無反向代理、無 TLS）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1000" height="580" as="geometry"/></mxCell><mxCell id="proc" value="uvicorn 單一 Python 行程 · 127.0.0.1:8002 --reload（README.md:49；install.ps1:79；install.sh:65）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="host"><mxGeometry x="250" y="40" width="420" height="500" as="geometry"/></mxCell><mxCell id="db" value="Docker 容器（本機或遠端主機，由 DB_HOST 決定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;verticalAlign=top;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1090" y="140" width="560" height="150" as="geometry"/></mxCell><mxCell id="ext" value="外部 HTTPS 出向（本機行程或瀏覽器發起）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1090" y="330" width="560" height="390" as="geometry"/></mxCell><mxCell id="web" value="瀏覽器：靜態單頁前端（MOD-WEB）
