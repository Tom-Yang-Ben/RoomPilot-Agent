.venv/
__pycache__/

# Claude Code 本機設定與工作流（每台機器自行維護，不進版控）
.claude/
*Zone.Identifier

# MCP 設定（含 API keys，不可提交）
.mcp.json
!.mcp.json.*.example

# 環境變數（含金鑰，不可提交）
.env

# 編譯後二進位（無原始碼，不進版控）
*.exe



# 本機自管大檔，不 push：訓練產物（打包件/微調模型/驗收快取）＋
# CubiCasa5k 程式庫與資料集＋官方權重 model_best_val_loss_var.pkl＋
# 換機：大檔整包 training.zip 搬運解壓；程式碼/測試/模板庫走版控（下方負向規則）
# （人工答案在 Identify_ans/ 進版控）
# training/ 只放訓練材料——辨識/評分的產出一律走 temp/（不進版控）。
# json/ 例外保留當警示網：現行 code 已不寫這裡，任何冒出來的檔案＝
# 某台機器還在跑舊版腳本，讓它在 git status 現形，不要無聲失蹤
training/*
!training/scripts/
!training/tests/
!training/json/
!training/*.npz
training/tests/.pytest_cache/
VibeCoding_Workflow_Templates/
training.zip
# 微調權重留專案根本地使用（200M 超 GitHub 100MB 限制），換機用 Drive/隨身碟帶
/model_finetuned_*.pkl
/backend/floorplan/model_finetuned_*.pkl
/cubicasa5k.zip

# 工作暫存（漏門裁圖、未標房間標示圖等除錯產物）
temp/
.mcp.json

# 應用程式執行狀態（跑 RoomPilot 時自動生成）：專案資料庫、使用者上傳的
# 平面圖、算圖輸出。每台機器各自累積，不該互相覆蓋
.runtime/

# macOS Finder 中繼檔（ben 端 macOS 工作機會持續產生）
.DS_Store
