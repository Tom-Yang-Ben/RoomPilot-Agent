.venv/
__pycache__/

# Claude Code 本機設定與工作流（每台機器自行維護，不進版控）
.claude/
*Zone.Identifier

# MCP 設定（含 API keys，不可提交）
.mcp.json
!.mcp.json.*.example

# 環境變數（含金鑰，不可提交）
.env

# 編譯後二進位（無原始碼，不進版控）
*.exe

# training/ 進版控走精簡集（2026-08-03 使用者裁定）：scripts/＋tests/
# 即為「clone 回來就能續作」的全部——training.zip 換機機制退場。
# 不入庫的三類：第三方 CubiCasa5k（需要時依 FloorTraining.md 另外
# clone）、可重生中間產物（room_crops 重訓前必以 extract_room_crops
# 重生、asset_ckpt 為素材輪斷點快取）、pytest 快取。
training/CubiCasa5k/
training/room_crops/
training/asset_ckpt/
training/tests/.pytest_cache/

# 工作流模板個人快取（工具會自行生成）
VibeCoding_Workflow_Templates/

# 工作暫存（評測報表、chk 疊圖等一切產出，不限深度——含以
# backend/floorplan/ 為 cwd 執行時落在該處的 temp/）
temp/

# macOS Finder 中繼檔（他端 macOS 工作機會產生）
.DS_Store
