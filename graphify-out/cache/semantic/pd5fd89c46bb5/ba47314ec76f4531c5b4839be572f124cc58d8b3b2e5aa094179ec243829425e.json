{"nodes": [{"id": "docs_bella_6_8_condensed_flow_spec", "label": "Bella Step 6-8 Condensed Flow Spec", "file_type": "document", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_bella_6_8_condensed_flow_spec_eight_step_workflow", "label": "Eight-Step Condensed Workflow", "file_type": "concept", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps 6-10 were collapsed into 6-8 because users had to reconfirm the same data across pages and could not tell whether they were editing, confirming, or generating output."}, {"id": "docs_bella_6_8_condensed_flow_spec_step_6_configuration_and_preview", "label": "Step 6 Configuration and Preview Workbench", "file_type": "concept", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3D is the primary canvas with a collapsible 2D side panel so users judge furniture-to-space relationships directly while keeping the overall plan visible."}, {"id": "docs_bella_6_8_condensed_flow_spec_step_7_locking_and_camera_selection", "label": "Step 7 Proposal Locking and Camera Selection", "file_type": "concept", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_bella_6_8_condensed_flow_spec_step_8_ai_rendering_and_proposal_package", "label": "Step 8 AI Rendering and Proposal Package", "file_type": "concept", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_bella_6_8_condensed_flow_spec_pending_invalid_furniture_list", "label": "Pending Invalid Furniture List", "file_type": "concept", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocking Step 7 entry while items remain, but always offering a locate-and-fix path, prevents an invalid proposal from being locked while avoiding a disabled button with no explanation."}, {"id": "docs_bella_6_8_condensed_flow_spec_three_candidate_palettes", "label": "Three Locked Candidate Palettes", "file_type": "concept", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed directions (safe/strong-style/accent) guarantee visibly different options; locking to exactly three bounds Step 8 cost and keeps the rendered result traceable to a confirmed choice."}, {"id": "docs_bella_6_8_condensed_flow_spec_locked_proposal_snapshot", "label": "Locked Proposal Snapshot", "file_type": "concept", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshotting furniture, materials, ceiling, lighting and risk list makes every rendered output traceable; returning to Step 6 invalidates it so stale renders cannot be mistaken for the current design."}, {"id": "docs_bella_6_8_condensed_flow_spec_two_d_three_d_shared_furniture_identity", "label": "Shared 2D/3D Furniture Identity", "file_type": "rationale", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "scene_objects furniture id is the primary key and 2D furniture points at the same object, so numbering, selection and position stay synchronized instead of duplicating semantics per view."}, {"id": "docs_bella_6_8_condensed_flow_spec_valid_furniture_never_auto_moved", "label": "Automatic Relayout Touches Only Invalid Furniture", "file_type": "rationale", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users must keep the final say: legal furniture keeps position and rotation, changes are listed with reasons, and any automatic reflow is undoable."}, {"id": "docs_bella_6_8_condensed_flow_spec_structure_change_return_to_step_4", "label": "Structure Change Returns to Step 4", "file_type": "rationale", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 6 allows only local wall corrections; large wall/room/opening edits go back to Step 4 after explaining impact and asking whether to keep the current arrangement."}, {"id": "docs_bella_6_8_condensed_flow_spec_indoor_walk_mode", "label": "Indoor Walk Inspection Mode", "file_type": "concept", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human-height camera with wall/furniture collision limits so circulation and scale can be judged without the camera passing through geometry or leaving the interior."}, {"id": "docs_bella_6_8_condensed_flow_spec_threejs_camera_candidates", "label": "Three.js Captured Camera Candidates", "file_type": "rationale", "source_file": "docs/BELLA_6_8_CONDENSED_FLOW_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Candidate views and Step 6 realism are Three.js material/lighting captures, not AI images, so users can compare compositions without spending image-generation quota; only Step 8 calls the external render service."}], "edges": [{"source": "docs_bella_6_8_condensed_flow_spec", "target": "docs_bell