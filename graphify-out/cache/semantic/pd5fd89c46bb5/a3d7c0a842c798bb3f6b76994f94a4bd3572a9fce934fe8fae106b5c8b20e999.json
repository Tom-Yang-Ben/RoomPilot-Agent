{"nodes": [{"id": "agents_cross_folder_change_protocol", "label": "\u8de8\u8cc7\u6599\u593e\u4fee\u6539 Cross-Folder Change Protocol", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Another owner's directory may only be touched when integration genuinely requires it, and the change must record primary owner, collaborating owner, files, changed data contract or flow, why it cannot be done in one directory, and both-end validation tests. Frontend fallback must not silently replace a backend algorithm, and the integrator must not redo another owner's core domain logic."}, {"id": "agents_ownership_table", "label": "Directory Ownership and Data Boundary Table", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_inviolable_contracts", "label": "\u4e0d\u53ef\u9055\u53cd\u7684\u5951\u7d04 Inviolable Contracts", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_validation_matrix", "label": "AGENTS.md \u9a57\u8b49\u77e9\u9663 Validation Matrix", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_no_wholesale_branch_merge", "label": "No Wholesale Member-Branch Merge", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remote member branches must never be copied or merged wholesale; only the smallest compatible feature may be ported after review, preventing a second FastAPI stack or an incompatible frontend from entering the product."}, {"id": "agents_centimetre_unit_contract", "label": "Centimetre Unit Contract (_cm / _m2)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-module geometry uses centimetres; new length/coordinate fields end in _cm and areas in _m2. Legacy fields width, depth, pos_x, pos_y must always travel with coordinate_unit: \"cm\" and a schema version so old and new payloads stay unambiguous."}, {"id": "agents_layout_json", "label": "layout_json Recognition Output", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Floorplan recognition terminates at layout_json; it carries walls, rooms, openings, beams and columns but never furniture placement."}, {"id": "agents_scene_json", "label": "scene_json Plan and Edit Output", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan generation and editing output scene_json, keeping the recognition boundary (layout_json) distinct from the design boundary so recognition changes cannot silently rewrite a design."}, {"id": "agents_graph_rag_boundary", "label": "Graph RAG Retrieval-Only Boundary", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Graph RAG may only retrieve relationships and evidence about rooms, furniture, styles, materials and constraints. It never decides geometry, collision, clearance or structural legality, so retrieval quality can never corrupt geometric correctness."}, {"id": "agents_furniture_vector_rag_boundary", "label": "Furniture Vector RAG Boundary", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Furniture vector RAG only parses requirements and retrieves/ranks Kai's PostgreSQL furniture; it must not replace Yen's selection decision or Ancai's geometric judgement."}, {"id": "agents_engine_geometry_authority", "label": "backend/engine/ as Sole Geometry Authority", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Furniture legality \u2014 placement, collision, clearance, movement \u2014 is decided only by backend/engine/. A single geometry authority prevents the browser, LLM or RAG layer from producing a competing and divergent answer."}, {"id": "agents_furniture_catalog_current_view", "label": "roompilot.furniture_catalog_current PostgreSQL View", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 6 official furniture reads Kai's PostgreSQL view first; verified JSON is used only when the database is temporarily unavailable."}, {"id": "agents_appliance_render_context_boundary", "label": "Appliance Questionnaire / render_context Boundary", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refrigerators, washing machines and other appliances stay as questionnaire and AI-render context (scene_json.render_context for step 8) and must never enter 2D/3D automatic placement or the official furniture API."}, {"id": "agents_quarantine_exclusion", "label": "Quarantine and Unmatched Data Exclusion", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quarantined or unmatched records must never reach the API or a scene; treating them as official furniture would publish unverified identity, dimensions or assets."}, {"id": "agents_bella", "label": "Bella (Owner: backend/server, production UI, integration)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_cody", "label": "Cody (Owner: backend/floorplan, backend/upgrade3d, testdata)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_django", "label": "Django (Owner: backend/spatial_data, evaluation, furniture RAG)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_kai", "label": "Kai (Owner: backend/catalog, JSON/, scripts/sql)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_yen", "label": "Yen (Owner: backend/agent, intent and selection)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_ancai", "label": "Ancai (Owner: backend/engine, geometry and legality)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_ben", "label": "Ben (QA: testdata, evaluation and version evidence)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_ownership_table", "target": "agents_bella", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents