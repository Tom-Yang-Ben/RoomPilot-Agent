{"nodes": [{"id": "backend_catalog_data_engineering_readme_structured_vs_rag_split", "label": "Structured Data vs RAG Document Split", "file_type": "rationale", "source_file": "backend/catalog/data/engineering/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only construction_knowledge titles/content, material method descriptions, construction cautions and professional-liability text belong in a vector index. Exact unit prices, productivity, dimensions, dates, quantities and work item codes must always go through structured queries, because a vector answer cannot guarantee numeric exactness."}, {"id": "backend_catalog_data_engineering_readme_demo_data_rules", "label": "Synthetic Demo Data Rules", "file_type": "rationale", "source_file": "backend/catalog/data/engineering/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "price_records.json and productivity_records.json numbers are synthetic, tagged region DEMO_ONLY, source_type synthetic_demo, is_synthetic true and confidence low. They exist only to test formulas, show the demo UI, produce complete HTML/XLSX and validate schedule dependencies, and must never be presented as New Taipei market rates or a formal quote."}, {"id": "backend_catalog_data_engineering_readme_productionization_path", "label": "Demo-to-Production Onboarding Path", "file_type": "concept", "source_file": "backend/catalog/data/engineering/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set ROOMPILOT_DEMO_MODE=false, create versions from production_templates/ or a real provider adapter with matching region, unit, date and source_id, update confidence and status after designer or contractor confirmation, and add a new effective_date version instead of overwriting history. Null pending templates must never be treated as confirmed prices."}, {"id": "backend_catalog_data_engineering_readme_noopengineeringsemanticretriever", "label": "NoopEngineeringSemanticRetriever", "file_type": "concept", "source_file": "backend/catalog/data/engineering/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit Mock/Noop that queries no real vector index. Going live only replaces the Semantic Retriever Adapter; exact numbers still travel through Structured Retrieval."}, {"id": "backend_catalog_data_engineering_readme_material_vs_workitem_price", "label": "Material Price vs Work-Item Price Separation", "file_type": "rationale", "source_file": "backend/catalog/data/engineering/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "material_catalog.json is for material selection and UI reference; price_records.json holds the Cost Service work-item unit prices already split into material, labour and other. The MVP must not double-count both sources in one total."}], "edges": [{"source": "backend_catalog_data_engineering_data_dictionary_constructionknowledge", "target": "backend_catalog_data_engineering_readme_structured_vs_rag_split", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/catalog/data/engineering/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_catalog_data_engineering_readme_noopengineeringsemanticretriever", "target": "backend_catalog_data_engineering_data_dictionary_constructionknowledge", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/catalog/data/engineering/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_catalog_data_engineering_readme_structured_vs_rag_split", "target": "agents_graph_rag_boundary", "relation": "semantically_similar_to", "confidence": "I