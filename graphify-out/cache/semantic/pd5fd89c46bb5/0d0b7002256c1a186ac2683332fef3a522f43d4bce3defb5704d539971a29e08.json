{"nodes": [{"id": "docs_contracts_postgresql_furniture_rag_runtime", "label": "PostgreSQL Furniture RAG Runtime Contract", "file_type": "document", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_RAG_RUNTIME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contracts_postgresql_furniture_rag_runtime_search_pipeline", "label": "RAG Search Pipeline", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_RAG_RUNTIME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parser to structured semantic_query, BGE-M3 vector, filtered SQL top-50 cosine, reranker top-20 (12 for inferred/accent), weighted 0.60 rerank + 0.20 style + 0.10 mood + 0.10 confidence, dedupe, then Kai catalog asset enrichment."}, {"id": "docs_contracts_postgresql_furniture_rag_runtime_hard_vs_soft_filters", "label": "SQL Hard Filters vs Ranking-Only Signals", "file_type": "rationale", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_RAG_RUNTIME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Room type, category, price, max width/height, role and size class are SQL hard conditions; style, mood and pattern may only affect ordering, and unspecified conditions stay null instead of being invented."}, {"id": "docs_contracts_postgresql_furniture_rag_runtime_search_filtered_function", "label": "roompilot.search_furniture_embeddings_filtered", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_RAG_RUNTIME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns ids, text, metadata and cosine distance but never the embedding, and matches only same model/dimension, active items and current text hash."}, {"id": "docs_contracts_postgresql_furniture_rag_runtime_job_api", "label": "Background RAG Job API and Progress", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_RAG_RUNTIME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Progress reports completed backend stages rather than an ETA, only one background job runs per process so two CPU model jobs cannot compete, and finished jobs are cleared after an hour."}, {"id": "docs_contracts_postgresql_furniture_rag_runtime_no_cross_provider_fallback", "label": "No Fallback Across Providers or Search Modes", "file_type": "rationale", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_RAG_RUNTIME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Errors map to 422/503/502 and the runtime must not silently switch to the other LLM provider, Chroma, JSON or keyword search - a degraded answer would misrepresent the retrieval contract."}, {"id": "docs_contracts_postgresql_furniture_rag_runtime_cpu_cost_boundary", "label": "CPU Model Load Dominates Latency", "file_type": "rationale", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_RAG_RUNTIME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact cosine over 9,349 rows is seconds, so lazy-loaded BGE-M3 and the cross-encoder reranker are the real cost; HNSW would only optimize the SQL segment, and cutting rerank candidates would change recall quality under a separate contract."}], "edges": [{"source": "docs_contracts_postgresql_furniture_rag_runtime", "target": "docs_contracts_postgresql_furniture_rag_runtime_search_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contracts/POSTGRESQL_FURNITURE_RAG_RUNTIME.md", "source_location": null, "weight": 1.0}, {"source": "docs_contracts_postgresql_furniture_rag_runtime", "target": "docs_contracts_postgresql_furn