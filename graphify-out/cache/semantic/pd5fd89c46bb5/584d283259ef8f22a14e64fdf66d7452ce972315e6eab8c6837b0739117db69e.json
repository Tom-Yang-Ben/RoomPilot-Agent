{"nodes": [{"id": "docs_contracts_postgresql_furniture_embeddings", "label": "PostgreSQL Furniture Embeddings Contract", "file_type": "document", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_EMBEDDINGS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contracts_postgresql_furniture_embeddings_table", "label": "roompilot.furniture_embeddings", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_EMBEDDINGS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RAG may not create a second table; all official vectors enter through this contract with UPSERT key (item_id, embedding_model, text_hash)."}, {"id": "docs_contracts_postgresql_furniture_embeddings_text_hash_validation", "label": "embedded_text SHA-256 Hash Validation", "file_type": "rationale", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_EMBEDDINGS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The importer rejects unknown item_ids, stale text or hashes, NaN/Infinity, wrong dimensions, duplicates and unnormalized vectors, so a vector can never drift away from the catalog text it encodes."}, {"id": "docs_contracts_postgresql_furniture_embeddings_bge_m3", "label": "BAAI/bge-m3 1024-d Cosine Normalized Target", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_EMBEDDINGS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contracts_postgresql_furniture_embeddings_deferred_hnsw", "label": "Deferred Fixed Dimension and HNSW Index", "file_type": "rationale", "source_file": "docs/contracts/POSTGRESQL_FURNITURE_EMBEDDINGS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development uses an unsized VECTOR c