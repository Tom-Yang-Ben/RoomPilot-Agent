{"nodes": [{"id": "docs_contracts_postgresql_catalog_crud_phase2", "label": "PostgreSQL Catalog Admin CRUD Phase 2", "file_type": "document", "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contracts_postgresql_catalog_crud_phase2_admin_furniture_api", "label": "/api/admin/furniture Admin API", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes are allowed only under ROOMPILOT_CATALOG_PROVIDER=postgres and behind a Bearer token; the actor header is audit metadata, never a credential, and public /api/furniture stays read-only."}, {"id": "docs_contracts_postgresql_catalog_crud_phase2_activation_gate", "label": "Activation Readiness Gate", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New items start as inactive drafts and can only be activated once name, cm dimensions, taxonomy, style/room/VLM annotation, a GLB and three ready view images all exist; otherwise 422 lists the missing pieces and the PATCH rolls back."}, {"id": "docs_contracts_postgresql_catalog_crud_phase2_soft_delete", "label": "Soft Delete via is_active=false", "file_type": "rationale", "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE never removes furniture, assets or history; the row remains visible to admin GET and audit but disappears from current views, the public API and 2D/3D scenes."}, {"id": "docs_contracts_postgresql_catalog_crud_phase2_optimistic_version_conflict", "label": "expected_updated_at Version Conflict (409)", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents two administrators from overwriting each other by rejecting writes whose expected timestamp no longer matches the database."}, {"id": "docs_contracts_postgresql_catalog_crud_phase2_admin_audit", "label": "roompilot.furniture_admin_audit", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audit rows commit inside the same transaction as the change and never store the Bearer token."}, {"id": "docs_contracts_postgresql_catalog_crud_phase2_importer_overwrite_risk", "label": "Importer May Overwrite Admin Patches", "file_type": "rationale", "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL patches to imported items can be overwritten by a later UPSERT of the same item_id, so permanent fixes must go back into Kai's source data; admin_api-only items are unaffected."}], "edges": [{"source": "docs_contracts_postgresql_catalog_crud_phase2", "target": "docs_contracts_postgresql_catalog_crud_phase2_admin_furniture_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "weight": 1.0}, {"source": "docs_contracts_postgresql_catalog_crud_phase2", "target": "docs_contracts_postgresql_catalog_crud_phase2_activation_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contracts/POSTGRESQL_CATALOG_CRUD_PHASE2.md", "source_location": null, "weight": 1.0}, {"source": "docs_contracts_postgresql_c