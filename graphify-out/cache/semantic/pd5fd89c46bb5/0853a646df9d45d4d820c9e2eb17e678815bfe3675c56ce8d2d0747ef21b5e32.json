{"nodes": [{"id": "docs_bella_test1_integration_log", "label": "Bella Test1 Integration Log", "file_type": "document", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_bella_test1_integration_log_ancai_dev_3d_selection_backport", "label": "Ancai-dev 3D Selection Backport", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The branch was not merged wholesale because it deletes Bella catalog, SQL, surface asset and test files; only low-risk viewer behavior preserving the current /scene visual style was backported."}, {"id": "docs_bella_test1_integration_log_2d_3d_selection_sync", "label": "Two-Way 2D/3D Furniture Selection Sync", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2D ids are matched to scene_objects[].furniture_id and programmatic syncs do not re-emit selection events, avoiding callback loops."}, {"id": "docs_bella_test1_integration_log_viewer_z_flip_boundary", "label": "Viewer-Only Z-Flip Coordinate Boundary", "file_type": "rationale", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical scene data stays in engine coordinates; the viewer clones a world frame with z flipped and converts back before validation/saving, so the mirror exists only at the visual boundary."}, {"id": "docs_bella_test1_integration_log_kai_postgresql_catalog_flow", "label": "Kai PostgreSQL Catalog Import Flow", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_bella_test1_integration_log_cody_v5_semantic_weight_contract", "label": "Cody v5 Semantic Weight Contract", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloads land in .part, must pass SHA-256, then atomically replace the target; CC_WEIGHTS overrides are never auto-downloaded and failures clean up partial files with explicit reasons."}, {"id": "docs_bella_test1_integration_log_cody_cubicasa_mask_adapter", "label": "Cody CubiCasa Mask Adapter Seam", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An injected runner and CC_INFER_SCRIPT keep the heavyweight torch/CubiCasa stack out of API import time and let the subprocess contract be tested without the 200MB model."}, {"id": "docs_bella_test1_integration_log_django_band_carve_backport", "label": "Django Band-Carve Opening Backport", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The deterministic wall-band carve was ported first instead of Django's torch CNN opening_ml.py, which depends on local sample folders and runtime training."}, {"id": "docs_bella_test1_integration_log_django_image_profile_seam", "label": "Django Version4 Image Profile Seam", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_bella_test1_integration_log_room_evaluation_helpers", "label": "Cody Room Recognition Evaluation Helpers", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_bella_test1_integration_log_appliance_catalog_retirement", "label": "Appliance Catalog Flow Retirement", "file_type": "rationale", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fridges and washers were removed from /api/appliances and auto-placement to match Kai's furniture-only catalog; they survive only as questionnaire and render_context hints for Step 8 image generation."}, {"id": "docs_bella_test1_integration_log_warning_proxy_for_unloadable_glb", "label": "Editable Warning Proxy for Unloadable GLB", "file_type": "rationale", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "White-box fallback rendering was removed because it hid failures; a translucent orange sized proxy keeps identity and transform controls while clearly not being a loaded catalog model, and model failures offer replacement rather than reflow."}, {"id": "docs_bella_test1_integration_log_cloudfront_glb_403_blocker", "label": "CloudFront/S3 Appliance GLB HTTP 403 Blocker", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_bella_test1_integration_log_utf8_mojibake_recovery", "label": "Guarded UTF-8 Mojibake Recovery", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repair only replaces byte-like strings when decoding increases valid CJK characters, so already-correct Traditional Chinese, English and accented names are preserved."}, {"id": "docs_bella_test1_integration_log_whole_house_surface_consistency", "label": "Whole-House Floor and Accent Wall Consistency", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared main floor plus a single accent wall per room removes the patchwork look; independent floors are kept only for wet/functional zones."}, {"id": "docs_bella_test1_integration_log_per_room_questionnaire_furniture_selection", "label": "Per-Room Questionnaire Furniture Selection", "file_type": "concept", "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Candidate GLBs are loaded in a hidden viewer before being offered, and Step 6 uses the exact checked catalog objects so the selection agent cannot substitute a different model."}], "edges": [{"source": "docs_bella_test1_integration_log", "target": "docs_bella_test1_integration_log_ancai_dev_3d_selection_backport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "weight": 1.0}, {"source": "docs_bella_test1_integration_log", "target": "docs_bella_test1_integration_log_2d_3d_selection_sync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "weight": 1.0}, {"source": "docs_bella_test1_integration_log", "target": "docs_bella_test1_integration_log_viewer_z_flip_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BELLA_TEST1_INTEGRATION_LOG.md", "source_location": null, "weight": 1.0}, {"source": "docs_bella_test1_integration_log", "target": "docs_bella_test1_integration_log_kai_postgresql_catalog_flow", "relation": "references", "c