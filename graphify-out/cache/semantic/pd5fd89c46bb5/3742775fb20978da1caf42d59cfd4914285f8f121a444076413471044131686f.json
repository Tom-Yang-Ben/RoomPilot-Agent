{"nodes": [{"id": "docs_contracts_postgresql_project_store_phase3", "label": "PostgreSQL Project Store Phase 3", "file_type": "document", "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contracts_postgresql_project_store_phase3_workflow_jsonb", "label": "roompilot.projects.workflow_json JSONB", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "layout_json, questionnaire, scene_json, per-room cameras and render context keep their existing workflow response contract; only the storage type changed, so URLs and frontend payloads stay untouched."}, {"id": "docs_contracts_postgresql_project_store_phase3_optimistic_concurrency", "label": "SELECT FOR UPDATE Revision Concurrency", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every write locks the project row, checks expected_revision (and expected_updated_at for pending replay), enforces a 2 MB workflow limit, and commits or rolls back atomically - preserving the 409/413/503 API contract."}, {"id": "docs_contracts_postgresql_project_store_phase3_sqlite_migration", "label": "One-Time SQLite to PostgreSQL Migration", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The migration is idempotent, runs in one transaction, never deletes the source sqlite file (kept as rollback evidence), and will not let an older SQLite revision overwrite a newer PostgreSQL one."}, {"id": "docs_contracts_postgresql_project_store_phase3_no_scene_object_tables", "label": "No Separate scene_objects Tables Yet", "file_type": "rationale", "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no per-object query requirement today, and any future derived table must come from scene_json under a versioned contract so it never becomes a second source of geometric truth."}, {"id": "docs_contracts_postgresql_project_store_phase3_engineering_tables", "label": "roompilot.engineering_snapshots/jobs/packages/documents", "file_type": "concept", "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots are unique per (project_id, design_revision) and snapshot_hash chains package and documents so all three outputs provably come from one locked snapshot."}], "edges": [{"source": "docs_contracts_postgresql_project_store_phase3", "target": "docs_contracts_postgresql_project_store_phase3_workflow_jsonb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "weight": 1.0}, {"source": "docs_contracts_postgresql_project_store_phase3", "target": "docs_contracts_postgresql_project_store_phase3_optimistic_concurrency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "weight": 1.0}, {"source": "docs_contracts_postgresql_project_store_phase3", "target": "docs_contracts_postgresql_project_store_phase3_sqlite_migration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contracts/POSTGRESQL_PROJECT_STORE_PHASE3.md", "source_location": null, "weight": 1.0}, {"source": "docs_cont