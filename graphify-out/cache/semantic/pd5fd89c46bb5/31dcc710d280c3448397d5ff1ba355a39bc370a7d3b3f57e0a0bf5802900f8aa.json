{"nodes": [{"id": "_agents_skills_roompilot_workflow_max_references_context_and_handoffs_decision_record", "label": "ADR Decision Record Trigger", "file_type": "rationale", "source_file": ".agents/skills/roompilot-workflow-max/references/context-and-handoffs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ADR is required only when a decision changes a public contract, provider, persistence model, architecture boundary, or expensive-to-reverse dependency, so cheap reversible choices are not burdened with paperwork. Each ADR must record evidence, rejected alternatives, owner confirmation, migration/rollback, producer/consumer tests, and a re-evaluation trigger."}, {"id": "_agents_skills_roompilot_workflow_max_references_context_and_handoffs_cross_owner_handoff", "label": "Cross-Owner Handoff Template", "file_type": "concept", "source_file": ".agents/skills/roompilot-workflow-max/references/context-and-handoffs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forces the author to name the primary owner, collaborating owner, changed data contract, why the change cannot be confined to one directory, and both-end validation tests, plus input/output artifact, units, schema version, persistence boundary and fallback."}, {"id": "_agents_skills_roompilot_workflow_max_references_context_and_handoffs_no_automatic_transcript_persistence", "label": "No Automatic Agent Transcript Persistence", "file_type": "rationale", "source_file": ".agents/skills/roompilot-workflow-max/references/context-and-handoffs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Knowledge is persisted only when the task requires a repository artifact; agent prompts, responses, session IDs, costs and activity logs are never written automatically, avoiding leakage of runtime/session data into the repo."}, {"id": "_agents_skills_roompilot_workflow_max_references_context_and_handoffs_known_live_contradictions", "label": "Known Live Contract Contradictions", "file_type": "concept", "source_file": ".agents/skills/roompilot-workflow-max/references/context-and-handoffs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three documented contradictions (PostgreSQL-preferred-with-JSON-fallback vs strict PostgreSQL/503; SQLite vs PostgreSQL default project store; remote-render step 8/9/10 wording vs the eight-step flow) must not be silently normalized. A workflow skill cannot resolve product-contract conflicts; the decision routes to Bella plus affected owners."}], "edges": [{"source": "_agents_skills_roompilot_workflow_max_references_context_and_handoffs_cross_owner_handoff", "target": "agents_cross_folder_change_protocol", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/roompilot-workflow-max/references/context-and-handoffs.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_roompilot_workflow_max_references_context_and_handoffs_cross_owner_handoff", "target": "agents_cross_folder_change_protocol", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".agents/skills/roompilot-workflow-max/references/context-and-handoffs.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_roompilot_workflow_max_references_context_and_handoffs_known_live_contradictions", "target": "readme_postgresql_catalog_provider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/roompilot-workflow-max/references/context-and-handoffs.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_roompilot_workflow_max_references_context_and_handoffs_known_live_contradictions", "target": "agents_furnit